# Legacy UHG experiment workspace; the canonical runner is experiments/UniGraph.
/scripts/UHG/

# Standalone UHG experiment outputs (keep runners and documentation tracked)
/experiments/UniGraph/index/
/experiments/UniGraph/result_pic/
/experiments/**/artifacts/
/experiments/**/bin/
/experiments/**/logs/
/experiments/**/markers/
/experiments/**/runs/

# Keep the compact published UniGraph audit archive; its local .gitignore still
# excludes new machine-specific run outputs.
!/experiments/UniGraph/runs/

# Keep UniGraph's compact ground-truth arrays in Git. The directory-local
# ignore file continues to exclude the large HDF5 payloads.
!/experiments/UniGraph/data/
